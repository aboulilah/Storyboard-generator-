export default async function handler(req, res) {
  if (req.method !== 'POST') {
    return res.status(405).json({ error: 'Method not allowed' });
  }

  const { idea, genre, platform, scenes } = req.body;

  if (!idea) {
    return res.status(400).json({ error: 'No idea provided' });
  }

  const prompt = `You are a professional storyboard director. A content manager has described their video idea. Generate a complete storyboard.

Their idea: "${idea}"
${genre ? 'Genre: ' + genre : ''}
${platform ? 'Platform: ' + platform : ''}
Number of scenes: ${scenes || 5}

Return ONLY valid JSON (no markdown, no backticks, no extra text):
{
  "projectTitle": "string",
  "logline": "one sentence that captures the essence of this video",
  "genre": "string",
  "platform": "string",
  "estimatedDuration": "string (e.g. 60 seconds)",
  "tone": "string",
  "scenes": [
    {
      "number": 1,
      "title": "string (short scene name)",
      "description": "2-3 sentences describing exactly what the viewer sees",
      "cameraAngle": "string (e.g. Wide establishing shot, Close-up, Handheld tracking)",
      "location": "string",
      "duration": "string (e.g. 8 seconds)",
      "mood": "string (1-2 words)",
      "dialogue": "string or null",
      "visualNotes": "string (lighting, color, movement)"
    }
  ]
}`;

  try {
    const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Authorization': `Bearer ${process.env.GROQ_API_KEY}`
      },
      body: JSON.stringify({
        model: 'llama3-8b-8192',
        max_tokens: 2000,
        messages: [{ role: 'user', content: prompt }]
      })
    });

    const data = await response.json();
    const raw = data.choices[0].message.content;
    const clean = raw.replace(/```json|```/g, '').trim();
    const parsed = JSON.parse(clean);

    return res.status(200).json(parsed);
  } catch (err) {
    return res.status(500).json({ error: 'Failed to generate storyboard. Please try again.' });
  }
}
